rules_version = '2';

// =============================================================================
// SPEAKSTEPS FIRESTORE SECURITY RULES (Updated Schema)
// =============================================================================
// 
// Collections:
//   /users/{userId} - User profiles (patients and therapists)
//   /exercises/{exerciseId} - Exercise definitions
//   /exercise_scores/{scoreId} - Completed exercise scores
//   /question_responses/{responseId} - Individual question responses
//   /exercise_sessions/{sessionId} - Exercise session tracking
//
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // HELPER FUNCTIONS
    // =========================================================================
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if user is a therapist
    function isTherapist() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'therapist';
    }
    
    // Check if user is a patient
    function isPatient() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'patient';
    }
    
    // Check if therapist owns this patient
    function therapistOwnsPatient(patientId) {
      return isTherapist() &&
             get(/databases/$(database)/documents/users/$(patientId)).data.therapistId == request.auth.uid;
    }
    
    // =========================================================================
    // USERS COLLECTION
    // /users/{userId}
    // =========================================================================
    match /users/{userId} {
      // Users can read their own document
      // Therapists can read their assigned patients
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        (isTherapist() && get(/databases/$(database)/documents/users/$(userId)).data.get('therapistId') == request.auth.uid)
      );
      
      // Users can create their own document during signup
      allow create: if isAuthenticated() && request.auth.uid == userId;
      
      // Users can update their own document
      // Therapists can update their assigned patients
      allow update: if isAuthenticated() && (
        request.auth.uid == userId ||
        (isTherapist() && get(/databases/$(database)/documents/users/$(userId)).data.get('therapistId') == request.auth.uid)
      );
      
      // Users can delete their own document
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }
    
    // =========================================================================
    // EXERCISES COLLECTION
    // /exercises/{exerciseId}
    // =========================================================================
    match /exercises/{exerciseId} {
      // Any authenticated user can read exercises
      allow read: if isAuthenticated();
      
      // Only therapists can create exercises
      allow create: if isTherapist();
      
      // Only therapists can update exercises
      allow update: if isTherapist();
      
      // Only therapists can delete exercises
      allow delete: if isTherapist();
    }
    
    // =========================================================================
    // EXERCISE SCORES COLLECTION
    // /exercise_scores/{scoreId}
    // =========================================================================
    match /exercise_scores/{scoreId} {
      // Patients can read their own scores
      // Therapists can read scores of their assigned patients
      allow read: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        therapistOwnsPatient(resource.data.patientId)
      );
      
      // Patients can create their own scores
      allow create: if isAuthenticated() && 
                       request.resource.data.patientId == request.auth.uid;
      
      // No updates allowed (scores are immutable)
      allow update: if false;
      
      // Only the patient who created can delete
      allow delete: if isAuthenticated() && resource.data.patientId == request.auth.uid;
    }
    
    // =========================================================================
    // QUESTION RESPONSES COLLECTION
    // /question_responses/{responseId}
    // =========================================================================
    match /question_responses/{responseId} {
      // Patients can read their own responses
      // Therapists can read responses of their assigned patients
      allow read: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        therapistOwnsPatient(resource.data.patientId)
      );
      
      // Patients can create their own responses
      allow create: if isAuthenticated() && 
                       request.resource.data.patientId == request.auth.uid;
      
      // No updates allowed (responses are immutable)
      allow update: if false;
      
      // Only the patient who created can delete
      allow delete: if isAuthenticated() && resource.data.patientId == request.auth.uid;
    }
    
    // =========================================================================
    // EXERCISE SESSIONS COLLECTION
    // /exercise_sessions/{sessionId}
    // =========================================================================
    match /exercise_sessions/{sessionId} {
      // Patients can read their own sessions
      // Therapists can read sessions of their assigned patients
      allow read: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        therapistOwnsPatient(resource.data.patientId)
      );
      
      // Patients can create their own sessions
      allow create: if isAuthenticated() && 
                       request.resource.data.patientId == request.auth.uid;
      
      // Patients can update their own sessions (to add end time, etc.)
      allow update: if isAuthenticated() && resource.data.patientId == request.auth.uid;
      
      // Only the patient who created can delete
      allow delete: if isAuthenticated() && resource.data.patientId == request.auth.uid;
    }
  }
}
